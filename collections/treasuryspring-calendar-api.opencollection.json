{
  "opencollection": "1.0.0",
  "info": {
    "name": "TreasurySpring Public Calendar API",
    "version": "v0.7.3"
  },
  "items": [
    {
      "info": {
        "name": "Calendar",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all holidays for a given year",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuryspring.com/api/v1/holidays/:year",
            "params": [
              {
                "name": "year",
                "value": "",
                "type": "path",
                "description": "Year"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a list of all holidays for a given year."
        }
      ]
    }
  ],
  "bundled": true
}